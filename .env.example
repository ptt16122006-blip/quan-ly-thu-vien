# ==============================================================================
# CẤU HÌNH DATABASE POSTGRESQL VÀ DOCKER COMPOSE
# ==============================================================================

# 1. Tài khoản Quản trị viên PostgreSQL (Superuser - dùng cho bảo trì, backup, pgAdmin)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_secret_pass_123
POSTGRES_DB=library_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 2. Tài khoản ứng dụng (Least Privilege - Non-Superuser)
# Tài khoản này chỉ có quyền SELECT, INSERT, UPDATE, DELETE và kết nối vào library_db.
# Không có quyền DROP DATABASE, CREATE ROLE, SUPERUSER...
APP_DB_USER=library_user
APP_DB_PASSWORD=library_app_secure_pass_2026

# Chuỗi kết nối Database cho ứng dụng FastAPI (Sử dụng tài khoản quyền tối thiểu)
DATABASE_URL=postgresql+psycopg2://${APP_DB_USER}:${APP_DB_PASSWORD}@postgres:5432/${POSTGRES_DB}

# 3. Quản trị qua pgAdmin Web UI
PGADMIN_DEFAULT_EMAIL=admin@library.com
PGADMIN_DEFAULT_PASSWORD=admin_password_123

# 4. Cấu hình ứng dụng FastAPI
APP_NAME="Hệ Thống Quản Lý Thư Viện"
DEBUG=True
SECRET_KEY=supersecretkey_library_management_2026
